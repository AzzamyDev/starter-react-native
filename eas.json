{
    "cli": {
        "version": ">= 13.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "android": { "buildType": "apk" },
            "ios": { "simulator": false },
            "env": { "APP_VARIANT": "development" }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "android": { "buildType": "apk" },
            "env": { "APP_VARIANT": "preview" }
        },
        "production": {
            "channel": "production",
            "android": { "buildType": "app-bundle" },
            "env": { "APP_VARIANT": "production" }
        }
    },
    "submit": { "production": {} }
}
