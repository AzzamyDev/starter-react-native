{
    "name": "expo-starter-kit",
    "version": "0.0.1",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start --dev-client",
        "ios": "expo run:ios --device",
        "ios:sim": "expo run:ios",
        "android": "expo run:android",
        "typecheck": "tsc --noEmit",
        "lint": "expo lint",
        "test": "jest",
        "format": "prettier --check .",
        "format:fix": "prettier --write --list-different .",
        "build:dev": "node scripts/build-helper.js development android auto --local",
        "build:preview": "node scripts/build-helper.js preview android auto --local",
        "build:prod": "node scripts/build-helper.js production android auto --local",
        "build:dev:ios": "node scripts/build-helper.js development ios auto --local",
        "build:preview:ios": "node scripts/build-helper.js preview ios auto --local",
        "build:prod:ios": "node scripts/build-helper.js production ios auto --local"
    },
    "jest": {
        "preset": "jest-expo",
        "transformIgnorePatterns": [
            "node_modules/(?!(\\.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg))"
        ]
    },
    "dependencies": {
        "@azzamydev/react-native-toast": "^0.1.1",
        "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
        "@expo-google-fonts/figtree": "^0.4.1",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@hookform/resolvers": "^6.0.0",
        "axios": "^1.20.0",
        "expo": "~58.0.17",
        "expo-blur": "~58.0.5",
        "expo-build-properties": "~58.0.11",
        "expo-constants": "~58.0.13",
        "expo-dev-client": "~58.0.14",
        "expo-font": "~58.0.9",
        "expo-haptics": "~58.0.7",
        "expo-linear-gradient": "~58.0.3",
        "expo-linking": "~58.0.14",
        "expo-router": "~58.0.25",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.11",
        "expo-status-bar": "~58.0.4",
        "expo-system-ui": "~58.0.6",
        "nativewind": "4.2.7",
        "react": "19.3.0",
        "react-hook-form": "^7.90.0",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-worklets": "0.13.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "~19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-expo": "^58.0.4",
        "jest": "^30.5.2",
        "jest-expo": "^58.0.12",
        "prettier": "^3.9.10",
        "tailwindcss": "3.4.17",
        "typescript": "~6.0.3"
    }
}
